# Copy this file to .env and fill in real values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Weaviate (defaults work with docker-compose) ─────────────────────────────
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── Document source ───────────────────────────────────────────────────────────
# Absolute path to the folder containing SEC 10-Q PDF files.
# Symlink or copy the corpus here, or set to the actual path.
DOCS_PATH=/Users/manjusri/learning/generative_ai/KG-RAG-datasets/sec-10-q/data/v1/docs

# ── Chunking (token-based) ────────────────────────────────────────────────────
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
