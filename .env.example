# Copy to .env and fill in OPENAI_API_KEY: `make env`

OPENAI_API_KEY=sk-...

# ── Weaviate connection ───────────────────────────────────────────────────────
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── SEC filing corpus ─────────────────────────────────────────────────────────
# Populated by `make link-docs` (symlinks an external corpus into ./data/docs).
DOCS_PATH=./data/docs

# ── Chunking (basic strategy) ─────────────────────────────────────────────────
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# ── Models ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
# Deliberately a different (stronger) model than GENERATION_MODEL — see
# RAG_STRATEGIES.md for why this matters for evaluation quality.
EVALUATION_MODEL=gpt-4o

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid
RETRIEVAL_HYBRID_ALPHA=0.5
RETRIEVAL_TOP_K=7

# More env vars (parent-child / semantic chunking, Weaviate collection names,
# generation temperature, etc.) are documented as defaults in src/config.py —
# only override them here if you need to change the default.
